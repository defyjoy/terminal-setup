# Ghostty config — tuned to match the iTerm2 "Default" profile
# (ComicShannsMono Nerd Font, background blur, glassy transparency)

# --- Font ---
font-family = "ComicShannsMono Nerd Font"
font-size = 15
adjust-cell-height = 0%

# --- Transparency & blur (matches iTerm2: Transparency 0.23, Blur Radius 64) ---
background-opacity = 0.77
background-blur = 64
background-opacity-cells = false

# --- Colors (matches iTerm2 "Default" profile, dark-mode colors — TokyoNight) ---
# iTerm2's "Default" profile uses separate Dark/Light colors and follows macOS
# appearance; Ghostty has no such auto-switch, so it was stuck on the Light
# variant (fafafa/101010) it had hardcoded. Pin it to the dark palette instead
# — it's an exact match for iTerm2's Dark colors (verified against the profile plist).
theme = Kanagawa Wave

# --- Window look & feel ---
# "tabs" merges the tab strip into the titlebar and matches it to the
# terminal background — the seamless, sleek tab look iTerm2 has.
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
window-theme = auto
window-padding-x = 10
window-padding-y = 10
window-decoration = auto
window-save-state = always

# --- Cursor ---
cursor-style = block
cursor-style-blink = false

# --- Behavior ---
copy-on-select = true
mouse-hide-while-typing = true
confirm-close-surface = false
shell-integration = detect
macos-option-as-alt = true
